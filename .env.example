# ==============================================================================
# PulseQueue SMS Gateway Configuration (Fast2SMS & MSG91)
# ==============================================================================
#
# Choose either Fast2SMS or MSG91 as your SMS delivery gateway.
# If no API key is specified, PulseQueue runs in transparent simulated sandbox mode
# for local testing, logging full SMS payload & generating mock message IDs.

# --- Option 1: Fast2SMS (Recommended for India Quick/DLT SMS) ---
# Sign up at https://www.fast2sms.com and get your API Key from Dev API tab
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# --- Option 2: MSG91 (Enterprise Flow / DLT API) ---
# Sign up at https://msg91.com and obtain your Auth Key & Template details
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_flow_template_id_here
MSG91_SENDER_ID=PLSQUE

# --- Optional Gateway Controls ---
# Explicitly choose gateway: 'fast2sms' | 'msg91' | 'mock'
SMS_GATEWAY=fast2sms

# Set to true to test failed delivery & retry flow in local development
SMS_SIMULATE_FAILURE=false

# ==============================================================================
# PulseQueue Email Notification Configuration (Nodemailer / Gmail SMTP)
# ==============================================================================
#
# Configure SMTP credentials for sending patient registration confirmation emails.
# If no SMTP credentials are provided, PulseQueue runs in simulated sandbox mode,
# logging the full email subject and body without sending external emails.
#
# For Gmail SMTP:
# 1. Enable 2-Step Verification in Google Account.
# 2. Generate an "App Password" (https://myaccount.google.com/apppasswords).
# 3. Enter your Gmail address in SMTP_USER and the 16-character App Password in SMTP_PASS.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_hospital_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="PulseQueue Outpatient OPD <your_hospital_email@gmail.com>"

# Set to true to test email delivery failure & retry flows in development
EMAIL_SIMULATE_FAILURE=false
